FROM ros:humble-ros-base
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip git ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir -U pip "setuptools<81" wheel \
 && pip3 install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip3 install --no-cache-dir lerobot
RUN pip3 install --no-cache-dir "transformers>=4.53,<5"
WORKDIR /workspace
